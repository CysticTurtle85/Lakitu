{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${authors}"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "icon": "assets/lakitu/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["net.cystic.lakitu.fabric.LakituFabric"],
    "client": ["net.cystic.lakitu.fabric.LakituFabricClient"]
  },
  "mixins": ["lakitu.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "minecraft": "${minecraft_range_fabric}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "geckolib": "*"
  }
}
